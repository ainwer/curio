# Copy to .env on the server and fill in real values there. Never commit .env.
# Values below are placeholders only.

# --- Tailscale ---------------------------------------------------------------
# One-time auth key. After the first successful start the node state lives in
# ./tailscale/state and this line can be removed.
TS_AUTHKEY=
TS_HOSTNAME=curio

# --- Host paths --------------------------------------------------------------
# Dedicated clone of the vault repository, used only by this app.
VAULT_PATH=/path/to/dedicated/vault-clone
# App data: SQLite database and converted books. Must be outside any Git repo.
DATA_PATH=/path/to/curio-data
# SSH deploy key with write access to the vault repository only.
VAULT_DEPLOY_KEY_PATH=/path/to/vault_deploy_key
# Optional: SSH known_hosts override for vault pushes; empty = packaged file.
VAULT_KNOWN_HOSTS_FILE=

# --- Vault layout ------------------------------------------------------------
VAULT_QUESTIONS_DIR=Learning/Questions
VAULT_PROFILE_PATH=Learning/Knowledge-Profile.md
VAULT_GIT_BRANCH=main

# --- LLM -----------------------------------------------------------------------
# anthropic | openai_compatible | fake
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-5-5
# Optional override for the tutor chat; empty = LLM_MODEL
LLM_TUTOR_MODEL=
# Anthropic only: low | medium | high | xhigh | max
LLM_EFFORT_GENERATION=medium
LLM_EFFORT_TUTOR=low
# Anthropic only: server-side refusal fallback, default | off
LLM_FALLBACK=default
ANTHROPIC_API_KEY=
# openai_compatible only
LLM_BASE_URL=
LLM_API_KEY=

# --- App -----------------------------------------------------------------------
CONVERTER_URL=http://converter:8001
MAX_UPLOAD_MB=200
LOG_LEVEL=INFO
